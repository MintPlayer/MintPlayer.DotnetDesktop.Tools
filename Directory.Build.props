<Project>

	<Import Project="versions.props" />

	<!--
	Imported BEFORE each project's own body, so anything set here is a DEFAULT the
	project can override. Conditions on project-declared properties ($(OutputType),
	$(IsPackable), ...) do NOT work here - those properties are not set yet and the
	condition silently never matches. Put that logic in Directory.Build.targets.
	-->

	<PropertyGroup>
		<!--
		SourceLink ships in the SDK since .NET 8, so no Microsoft.SourceLink.* package is
		needed. But the SDK provides the source MAPPING only - without these two the
		repository URL never lands in the nupkg and untracked generated sources are not
		embedded in the PDB.
		-->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>

	<PropertyGroup>
		<!--
		Belt and braces over the explicit <IsPackable>false</IsPackable> that every test
		project carries. publish-release.yml pushes "**/*.nupkg" to nuget.org, and that is
		not reversible - a package can only be delisted, never unpublished. A test project
		that leaks onto nuget.org by omission is therefore a permanent mistake, so the
		guard keys off the filename rather than trusting each csproj to remember.
		-->
		<IsPackable Condition="$(MSBuildProjectName.EndsWith('.Tests'))">false</IsPackable>
	</PropertyGroup>

	<!--
	Shared test-project setup, so six csproj files do not repeat it.

	OutputType=Exe is REQUIRED by xUnit v3 (it self-hosts, and does not infer this). It also
	keeps test projects out of the symbol-package settings in Directory.Build.targets, which
	key off OutputType == Library.

	Coverage comes from Microsoft.Testing.Extensions.CodeCoverage, not coverlet: xUnit v3
	runs on Microsoft.Testing.Platform, and MTP dropped its VSTest bridge on the .NET 10 SDK
	and later, so the "XPlat Code Coverage" data collector cannot attach at all. The runner
	itself is selected in global.json ("test": { "runner": "Microsoft.Testing.Platform" });
	without that, dotnet test still routes through the VSTest target and every test project
	fails to run.
	-->
	<PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
		<OutputType>Exe</OutputType>
		<IsTestProject>true</IsTestProject>
		<LangVersion>15</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
	</PropertyGroup>

	<ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
		<PackageReference Include="xunit.v3" Version="4.0.1" />
		<Using Include="Xunit" />
	</ItemGroup>

</Project>
