<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0-windows</TargetFramework>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<!--
		The tests never open a window, but they are WinForms-bound all the same: the tool
		and picker assertions speak in Keys and Point, which arrive through the implicit
		WinForms/Drawing global usings.
		-->
		<UseWindowsForms>true</UseWindowsForms>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\MintPlayer.ThreeDee\MintPlayer.ThreeDee.csproj" />
		<!--
		DemoScene.Build() provides a realistic multi-face scene for the render-mesh
		assertions. It is why [*.Demo]* has to be excluded from coverage: without that,
		the 1480-line demo app would be measured as if it were library code.
		-->
		<ProjectReference Include="..\MintPlayer.ThreeDee.Demo\MintPlayer.ThreeDee.Demo.csproj" />
	</ItemGroup>

</Project>
